	partition dim_municipio = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "dim_municipio.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalho, {{"cod_ibge", type text}, {"municipio", type text}, {"uf", type text}, {"local_mapa", type text}, {"latitude", type number}, {"longitude", type number}}, "pt-BR")
				in
				    Tipos

	annotation PBI_ResultType = Table

