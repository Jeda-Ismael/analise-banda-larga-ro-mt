table dim_municipio
	lineageTag: c09fcd74-4e72-490d-8b88-7469a585c1e2

	column cod_ibge
		dataType: string
		lineageTag: 5249a2d5-d105-4daa-aa08-a3753452de40
		summarizeBy: none
		sourceColumn: cod_ibge

		annotation SummarizationSetBy = Automatic

	column municipio
		dataType: string
		lineageTag: d855f1d1-d81a-4c2a-a660-168608f16134
		dataCategory: City
		summarizeBy: none
		sourceColumn: municipio

		annotation SummarizationSetBy = Automatic

	column uf
		dataType: string
		lineageTag: 3705add8-de6f-4e00-bef7-e10dbf2d0048
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: uf

		annotation SummarizationSetBy = Automatic

	column local_mapa
		dataType: string
		lineageTag: 2094a30e-59e0-4edf-afdb-b51f94ce84ee
		dataCategory: Place
		summarizeBy: none
