table dCalendario
	lineageTag: ccf579a4-3cf4-4d45-a46a-cad8a9513429
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: 606bd8b5-f676-4ff9-b759-9c5eec8342a5
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Ano
		dataType: int64
		formatString: 0
		lineageTag: 530ddfde-df6a-4c8d-9b68-4ca7e3f052a1
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ano]

		annotation SummarizationSetBy = Automatic

	column Mês
		dataType: int64
		formatString: 0
		lineageTag: ee7f1928-fc27-4bf2-b7ba-56fb2af951b0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mês]

		annotation SummarizationSetBy = Automatic

	column AnoMes
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 72d9fd20-680a-4975-b6c7-e34d135bdeb5
		summarizeBy: none
		isNameInferred
		sourceColumn: [AnoMes]

		annotation SummarizationSetBy = Automatic

	column Mês/Ano
		dataType: string
		lineageTag: 128bf0eb-8ab9-4ace-8c21-4a0b88e8d37b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mês/Ano]
		sortByColumn: AnoMes

		annotation SummarizationSetBy = Automatic

	partition dCalendario = calculated
		mode: import
		source =
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2019, 1, 1 ), EOMONTH ( MAX ( fato_acessos[data] ), 0 ) ),
				    "Ano", YEAR ( [Date] ),
				    "Mês", MONTH ( [Date] ),
				    "Mês/Ano", FORMAT ( [Date], "mmm/yy" ),
				    "AnoMes", YEAR ( [Date] ) * 100 + MONTH ( [Date] )
				)

	annotation PBI_Id = 41f80fabe5ac402e9d104209858597f1

