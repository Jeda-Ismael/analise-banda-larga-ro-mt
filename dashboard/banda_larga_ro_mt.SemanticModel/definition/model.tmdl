model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["fato_acessos","fato_densidade","dim_municipio","dim_prestadora","PastaDados"]

ref table fato_acessos
ref table fato_densidade
ref table dim_municipio
ref table dim_prestadora
ref table dCalendario

ref cultureInfo pt-BR

